{
  "name": "alpha-recovery",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "scripts": {
    "start": "npm run preview",
    "start:react": "vite --host 127.0.0.1 --port 3000 --open /react-index.html",
    "build": "node scripts/build-static.js",
    "build:react": "vite build",
    "editor": "node scripts/editor.js",
    "preview": "npm run build && node scripts/preview.js",
    "test": "npm run build && npm run build:react"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version"
    ]
  },
  "description": "Static public website for Alpha Recovery LLC. Deployed with GitHub Pages.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlphaRecovery/Website.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AlphaRecovery/Website/issues"
  },
  "homepage": "https://github.com/AlphaRecovery/Website#readme",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.0"
  }
}
