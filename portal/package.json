{
  "name": "alpha-recovery-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:server",
    "dev:client": "cross-env PORTAL_APP_BASE=/ vite --host 127.0.0.1 --port 5173 client",
    "dev:server": "node --watch server/index.js",
    "build": "vite build client",
    "build:vercel": "cross-env PORTAL_APP_BASE=/ vite build client",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "check": "npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.1",
    "multer": "^2.1.1",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.170.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "vite": "^8.0.14"
  }
}
